---
// Blog index. Posts are written in Chinese, so the blog has no English mirror.
import Base from '../../layouts/Base.astro';
import { makeLink } from '../../lib/paths';
import { getPosts, formatDate } from '../../lib/blog';

const link = makeLink('zh');
const posts = await getPosts();
---
<Base lang="zh" path="blog/" title="博客 | 陈佳绍" description="陈佳绍的博客：做软件的记录。" section="blog" zhOnly>

  <div class="page-title dark-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">博客</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href={link('')}>首页</a></li>
          <li class="current">博客</li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="blog-page section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="blog-empty">还没有发布文章。第一篇写好后会出现在这里。</p>
      ) : (
        <ol class="post-list">
          {posts.map(post => (
            <li>
              <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
              <h2><a href={link(`blog/${post.id}/`)}>{post.data.title}</a>{post.data.draft && <span class="status-badge status-planned">草稿</span>}</h2>
              <p>{post.data.summary}</p>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

</Base>
