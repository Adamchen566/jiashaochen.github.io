---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { makeLink } from '../../lib/paths';
import { getPosts, formatDate } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const link = makeLink('zh');
---
<Base lang="zh" path={`blog/${post.id}/`} title={`${post.data.title} | 陈佳绍`} description={post.data.summary} section="blog" zhOnly>

  <div class="page-title dark-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">博客</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href={link('')}>首页</a></li>
          <li><a href={link('blog/')}>博客</a></li>
          <li class="current">{post.data.title}</li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="blog-page section">
    <div class="container">
      <article class="post">
        <header>
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
          <h1>{post.data.title}</h1>
          <p class="post-summary">{post.data.summary}</p>
        </header>
        <div class="post-body">
          <Content />
        </div>
        <p class="post-back"><a href={link('blog/')}>返回全部文章</a></p>
      </article>
    </div>
  </section>

</Base>
