---
// Product page for Mianyu, rendered for /products/mianyu/ and /en/products/mianyu/.
import Base from '../layouts/Base.astro';
import { asset, makeLink, type Lang } from '../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const link = makeLink(lang);

const content = {
  zh: {
    site: '陈佳绍',
    title: '眠屿 · 睡前听的声音 App',
    description: '眠屿是一款睡前听的声音 App：雨声、白噪音、ASMR 多轨混音，手势调音量，睡眠定时。安卓 1.10 内测中，由陈佳绍一人独立开发。',
    home: '首页',
    products: '产品',
    crumb: '眠屿',
    videoFallback: '你的浏览器不支持播放视频，可以直接下载宣传片观看。',
    info: '产品信息',
    rows: [
      ['状态', ''],
      ['平台', '安卓（iOS 计划中）'],
      ['开发', '陈佳绍，一人独立完成'],
      ['技术', 'React · TypeScript · Capacitor · Fastify · SQLite · 腾讯云'],
      ['下载', '内测中，暂时没有开放下载'],
    ],
    status: '安卓 1.10 · 内测中',
    sep: '：',
    whatTitle: '它是做什么的',
    what: '又到这个点了，脑子还没下班。眠屿让它先下班：打开之后不用挑，点一下就开始播放一组适合睡前听的声音。',
    cta: '加微信申请内测',
    featuresTitle: '现在能用的功能',
    features: [
      '主页是一组气泡，每个气泡是一种声音，可以多轨叠在一起听',
      '在气泡上用手势调音量，也可以单独暂停某一个声音',
      '长按背景添加新的声音',
      '5 到 240 分钟的睡眠定时，结束时声音慢慢淡出',
      '收藏常用的声音和组合，登录后在账号间同步',
      '49 条循环声：自然 27 条、噪音 11 条、ASMR 11 条',
    ],
    galleryTitle: '第一版宣传图文',
    galleryAlt: '眠屿宣传图',
    notesTitle: '说明',
    notes: [
      '睡前故事和知识节目由 AI 撰写、合成语音朗读，内容虚构，节目还在制作中，即将上线。',
      '“告诉它今晚的状态，让它配一组声音”这部分还在调试，宣传图里的组合是本地规则配出来的。',
      '宣传片为了画面简洁隐藏了部分界面控件，这些控件在 App 里实际存在。',
      '眠屿是放松用的声音工具，不是医疗产品。',
    ],
  },
  en: {
    site: 'Jiashao Chen',
    title: 'Mianyu · sounds for bedtime',
    description: 'Mianyu is a bedtime sound app: rain, noise and ASMR layered together, gesture volume control and a sleep timer. Android 1.10 is in beta, built solo by Jiashao Chen.',
    home: 'Home',
    products: 'Products',
    crumb: 'Mianyu',
    videoFallback: 'Your browser cannot play this video. You can download the promo instead.',
    info: 'Product information',
    rows: [
      ['Status', ''],
      ['Platform', 'Android (iOS planned)'],
      ['Developer', 'Jiashao Chen, solo'],
      ['Stack', 'React · TypeScript · Capacitor · Fastify · SQLite · Tencent Cloud'],
      ['Download', 'In beta, not open for download yet'],
    ],
    status: 'Android 1.10 · in beta',
    sep: ': ',
    whatTitle: 'What it does',
    what: 'It is late again and your mind is still at work. Mianyu lets it clock off: open the app, skip the choosing, and one tap starts a set of sounds suited to bedtime.',
    cta: 'Join the beta on WeChat',
    featuresTitle: 'What works today',
    features: [
      'The home screen is a set of bubbles, one per sound, and they can be layered together',
      'Adjust volume with gestures on each bubble, or pause a single sound',
      'Long-press the background to add another sound',
      'Sleep timer from 5 to 240 minutes with a slow fade-out at the end',
      'Save favourite sounds and mixes; they sync across devices once you sign in',
      '49 looping sounds: 27 nature, 11 noise, 11 ASMR',
    ],
    galleryTitle: 'First promo image set (in Chinese)',
    galleryAlt: 'Mianyu promo image',
    notesTitle: 'Notes',
    notes: [
      'Bedtime stories and knowledge programmes are written by AI and read by synthesised voices. They are fictional, still in production and coming soon.',
      'The "tell it how tonight feels and let it pick a mix" feature is still being tuned; the mixes in the promo images were chosen by local rules.',
      'The promo video hides some interface controls to keep the picture simple. Those controls exist in the app.',
      'Mianyu is a sound tool for relaxing, not a medical product.',
    ],
  },
}[lang];

const images = Array.from({ length: 9 }, (_, i) => `assets/img/products/mianyu/promo-${String(i + 1).padStart(2, '0')}.jpg`);
const half = Math.ceil(content.features.length / 2);
---
<Base lang={lang} path="products/mianyu/" title={`${content.title} | ${content.site}`} description={content.description} section="products">

  <!-- Page Title -->
  <div class="page-title dark-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">{content.title}</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href={link('')}>{content.home}</a></li>
          <li><a href={`${link('')}#products`}>{content.products}</a></li>
          <li class="current">{content.crumb}</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <section id="portfolio-details" class="portfolio-details product-detail section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

      <div class="row gy-4">

        <div class="col-lg-5">
          <video class="product-video" controls playsinline preload="none" poster={asset('assets/img/products/mianyu/video-poster.jpg')}>
            <source src={asset('assets/video/mianyu-promo-30s.mp4')} type="video/mp4">
            {content.videoFallback}
          </video>
        </div>

        <div class="col-lg-7">
          <div class="portfolio-info" data-aos="fade-up" data-aos-delay="200">
            <h3>{content.info}</h3>
            <ul>
              {content.rows.map(([label, value], index) => (
                <li><strong>{label}</strong>{content.sep}{index === 0 ? <span class="status-badge status-beta">{content.status}</span> : value}</li>
              ))}
            </ul>
          </div>
          <div class="portfolio-description" data-aos="fade-up" data-aos-delay="300">
            <h2>{content.whatTitle}</h2>
            <p>{content.what}</p>
            <a href={asset('assets/img/wechat-qr.png')} class="btn-product btn-product-primary glightbox">{content.cta}</a>
          </div>
        </div>

      </div>

      <h2>{content.featuresTitle}</h2>
      <div class="row gy-3">
        <div class="col-md-6">
          <ul>{content.features.slice(0, half).map(item => <li>{item}</li>)}</ul>
        </div>
        <div class="col-md-6">
          <ul>{content.features.slice(half).map(item => <li>{item}</li>)}</ul>
        </div>
      </div>

      <h2>{content.galleryTitle}</h2>
      <div class="row g-3 promo-gallery">
        {images.map((image, index) => (
          <div class="col-6 col-md-4 col-lg-3">
            <a href={asset(image)} class="glightbox" data-gallery="mianyu">
              <img src={asset(image)} alt={`${content.galleryAlt} ${index + 1}`} loading="lazy" width="900" height="1200">
            </a>
          </div>
        ))}
      </div>

      <h2>{content.notesTitle}</h2>
      <ul class="product-notes">
        {content.notes.map(item => <li>{item}</li>)}
      </ul>

    </div>

  </section>

</Base>
